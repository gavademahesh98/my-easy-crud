pipeline{
    agent{
        label 'worker1'
    }
    tools{
        maven 'mvn'
    }
    environment{
        aws_cred=credentials('aws-cred')
    }
    stages{
        stage('backend-checkout'){
            steps{
                git branch: 'main' , url: "https://github.com/gavademahesh98/my-easy-crud.git"
            }
        }
        stage('maven-build'){
            steps{
                dir('backend'){
                    sh 'mvn clean package -DskipTests'
                }
            }
            post{
                success{
                    archiveArtifacts artifacts: 'backend/target/*.jar' , fingerprint: true
                }
            }
        }
        stage('sonar Analysis'){
            steps{
                dir('backend'){
                    withSonarQubeEnv('sonar-server'){
                        sh 'mvn sonar:sonar'
                    }
                }
            }
        }
        stage('Quality-Gate'){
            steps{
                timeout(time: 5 , unit: 'MINUTES'){
                    waitForQualityGate abortPipeline: true
                }
            }
            post {
                failure {
                    script {

                        def sonarProperties = readProperties file: 'backend/target/sonar/report-task.txt'

                        def sonarIssuesUrl =
                            "${sonarProperties.serverUrl}/project/issues?id=${URLEncoder.encode(sonarProperties.projectKey, 'UTF-8')}"

                        emailext(
                            subject: "SonarQube Quality Gate Failed - ${env.JOB_NAME} #${env.BUILD_NUMBER}",

                            body: """
                                <p>SonarQube Quality Gate failed.</p>

                                <p>
                                    <a href="${sonarIssuesUrl}">
                                        <b>View SonarQube Issues Report</b>
                                    </a>
                                </p>
                            """,

                            mimeType: 'text/html',

                            to: 'gavademahesh98@gmail.com'
                        )
                    }
                }
            }
        }
        stage('artifacts-to-s3'){
            steps{
                dir('backend'){
                    sh 'aws s3 cp target/*.jar s3://easycrud-student/student-service/'
                }
            }
        }
        stage('docker-build'){
            steps{
                dir('backend'){
                    sh 'docker build --no-cache -t easy-crud-backend:${BUILD_NUMBER} .'
                    docker images
                }
            }
        }
    }
}