pipeline{
    agent{
        label 'worker1'
    }
    tools{
        nodejs 'nodejs'
        maven 'mvn'
    }
    environment{
        aws_cred=credentials('aws-cred')
    }
    stages{
        stage('frontend-checkout'){
            steps{
                git branch: 'main' , url: 'https://github.com/gavademahesh98/my-easy-crud.git'
            }
        }
        stage('build-frontend'){
            steps{
                dir('frontend'){
                    sh '''
                    npm install 
                    npm run build
                    '''
                }
            }
            post{
                success{
                    archiveArtifacts artifacts: 'frontend/dist/**', fingerprint: true
                }
            }
        }
        stage('sonar-scan'){
            steps{
                dir('frontend'){
                    withSonarQubeEnv('sonar-server'){
                        sh 'mvn sonar:sonar'
                    }
                }
            }
        }
        stage('Quality-gate'){
            steps{
                timeout(time:5 , unit: 'MINUTES'){
                    waitForQualityGate abortPipeline: true
                }
            }
        }
    }
}