pipeline{
    agent{
        label 'worker1'
    }
    tools{
        nodejs 'nodejs'
        maven 'mvn'
    }
    environment{
        aws_cred=credentials('aws-cred')
        FRONTEND_REPO='655887417250.dkr.ecr.ap-southeast-1.amazonaws.com/frontend-service'
    }
    stages{
        stage('frontend-checkout'){
            steps{
                git branch: 'main' , url: 'https://github.com/gavademahesh98/my-easy-crud.git'
            }
        }
        stage('build-frontend'){
            steps{
                dir('frontend'){
                    sh '''
                    npm install 
                    npm run build
                    '''
                }
            }
            post{
                success{
                    archiveArtifacts artifacts: 'frontend/dist/**', fingerprint: true
                }
            }
        }
        stage('sonar-scan') {
             steps {
                  dir('frontend') {
                      withSonarQubeEnv('sonar-server') {
                       script{
                          def scannerHome = tool name: 'sonar-scanner', type: 'hudson.plugins.sonar.SonarRunnerInstallation'

                          sh "${scannerHome}/bin/sonar-scanner"
                       }
                      }
                    }
            }
        }
        stage('Quality-gate'){
            steps{
                timeout(time:5 , unit: 'MINUTES'){
                    waitForQualityGate abortPipeline: true
                }
            }
        }
        stage('artifacts-to-s3'){
            steps{
                sh 'aws s3 sync frontend/dist/ s3://frontend-service-artifacts/'
            }
        }
        stage('docker-build'){
            steps{
                dir('frontend'){
                sh "docker build --no-cache -t frontend-service:${BUILD_NUMBER} . "
                }
            }
        }
        stage('push image to ECR'){
            steps{
                sh """
                aws ecr get-login-password --region ap-southeast-1 | \
                docker login --username AWS --password-stdin 655887417250.dkr.ecr.ap-southeast-1.amazonaws.com
                docker tag frontend-service:${BUILD_NUMBER} ${FRONTEND_REPO}:${BUILD_NUMBER}
                docker push ${FRONTEND_REPO}:${BUILD_NUMBER}
                """
            }
        }
        stage('image-Update-frontend-deployment'){
            steps{
                sh 'sed -i "s|image:.*|image: ${FRONTEND_REPO}:${BUILD_NUMBER}|" k8s/frontend/frontend-deployment.yaml'
            }
        }
        stage('Image-push-to-github'){
            steps{
                withCredentials([
                usernamePassword(
                credentialsId: 'github-cred',
                usernameVariable: 'GIT_USERNAME',
                passwordVariable: 'GIT_TOKEN'
            )
          ]) {
            sh """
             git config  user.name "maheshgavade"
             git config user.email "gavademahesh98@gmail.com"
            git add k8s/frontend/frontend-deployment.yaml
            git commit -m "Change frontend deployment image tag to ${BUILD_NUMBER}"
            git push https://$GIT_USERNAME:$GIT_TOKEN@github.com/gavademahesh98/my-easy-crud.git HEAD:main
            """
           }
            }
        }
        stage('argocd-deployment'){
            steps{
                sh """
                aws eks update-kubeconfig --region ap-southeast-1 ---name dev-cluster
                kubectl apply -f argocd/frontend-application.yaml
                kubectl apply -f argocd/ingress-application.yaml
                kubectl get app -n argocd
                sleep 10
                kubectl get pods 
                kubectl get svc -o wide
                """
            }
        }


    }
}